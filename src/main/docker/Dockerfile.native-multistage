####
# Dockerfile multi-stage pour spaquarkus en mode natif (sans GraalVM sur l'hôte).
#
# Trois étapes :
#   1. Compilation Java avec Maven (eclipse-temurin:25)
#       -> génère les sources pour native-image (-Dquarkus.native.sources-only=true)
#   2. Compilation native avec Mandrel pour JDK 25
#       -> produit le binaire Linux 64-bit
#   3. Image runtime ultra-légère (~9 Mo) basée sur ubi9-quarkus-micro-image
#
# Construire l'image avec :
#
#   docker build -f src/main/docker/Dockerfile.native-multistage -t spaquarkus:native .
#
# Lancer le conteneur avec :
#
#   docker run -i --rm -p 8080:8080 spaquarkus:native
####

## ---- Étape 1 : Compilation Java et génération des sources pour native-image ----
FROM maven:3.9-eclipse-temurin-25 AS mvn-build

WORKDIR /code

# Copie le descripteur de dépendances en premier pour bénéficier du cache Docker
COPY pom.xml .
RUN mvn -B dependency:go-offline -q

COPY src ./src
# Génère les sources native-image sans lancer la compilation native
# (séparation recommandée par la doc Quarkus pour les pipelines CI/CD)
RUN mvn package -Dnative -Dquarkus.native.sources-only=true -DskipTests -q

## ---- Étape 2 : Compilation native avec Mandrel (GraalVM community) ----
FROM quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-25 AS native-build

COPY --chown=quarkus:quarkus --from=mvn-build /code/target/native-sources /home/quarkus/code/

WORKDIR /home/quarkus/code
# native-image.args contient tous les arguments générés par Quarkus
RUN native-image $(cat native-image.args)

## ---- Étape 3 : Image runtime finale ultra-légère ----
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0

WORKDIR /work/

COPY --from=native-build /home/quarkus/code/*-runner /work/application

RUN chmod 775 /work /work/application \
    && chown -R 1001 /work \
    && chmod -R "g+rwX" /work \
    && chown -R 1001:root /work

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
